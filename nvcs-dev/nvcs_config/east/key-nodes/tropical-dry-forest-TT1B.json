{
    "node": {
        "name": "Tropical Dry Forest (TT1.b)",
        "id": "TT1b",
        "level": "subbiome",
        "description": [
            "Tropical hardwood and tropical conifer forests found in Puerto Rico, U.S. Virgin Islands,",
            "and in tropical Florida (EcoSection 411A)"
        ],
        "trigger": [
            "match(TERRITORIES) or",
            "(match(FLORIDA) and match(TROPICAL_FLORIDA))"
        ],
        "filters": {
            "TROPICAL_FLORIDA": [
                {
                    "ecoregion": "411A"
                }
            ],
            "TERRITORIES": [
                {
                    "state": "PR"
                },
                {
                    "state": "VI"
                }
            ],
            "FLORIDA": [
                {
                    "state": "FL"
                }
            ]
        }
    }
}